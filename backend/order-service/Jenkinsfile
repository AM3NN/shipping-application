pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK23'
    }

    environment {
        SONAR_PROJECT_KEY = 'order-service'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: 'refs/heads/amen-React']],
                    userRemoteConfigs: [[url: 'https://github.com/AM3NN/shipping-application.git']],
                    extensions: [[$class: 'CloneOption', noTags: false, shallow: false, depth: 0]]
                ])
            }
        }

        stage('Build, Test & SonarQube Analysis') {
            steps {
                dir('backend/order-service') {
                    // This uses the SonarQube server config named 'sonar-server'
                    withSonarQubeEnv('sonar-server') {
                        bat "mvn clean verify sonar:sonar -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} -Dmaven.test.failure.ignore=false"
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit 'backend/order-service/target/surefire-reports/*.xml'
            }
        }

        stage('Publish JaCoCo Report') {
            steps {
                jacoco execPattern: '**/target/jacoco.exec',
                       classPattern: '**/target/classes',
                       sourcePattern: '**/src/main/java',
                       exclusionPattern: '**/target/test-classes'
            }
        }
    }
}
